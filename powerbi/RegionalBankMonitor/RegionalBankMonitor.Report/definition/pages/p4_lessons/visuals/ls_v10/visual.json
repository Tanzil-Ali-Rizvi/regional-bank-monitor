              {
                "textRuns": [
                  {
                    "value": "What set them apart",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#24324D",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "All three had uninsured deposits above 60%, deposit growth above 90% since 2019 and CET1 below 8% once securities losses are counted; no surviving bank had all three, and four had two.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#24324D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Securities losses alone did not separate them: 28 survivors had deeper losses relative to capital than Signature.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#24324D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "First Republic's deposits fell from $176B to $104B (-41%) in Q1 2023. The thresholds were chosen with hindsight: 36 of 80 tested settings catch all three failures and none flags more than one survivor.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#24324D"
                    }
                  }
                ]
              }
            ]
          }
        }
