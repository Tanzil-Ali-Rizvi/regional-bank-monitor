		isHidden
		displayFolder: 00 Base (unscoped)
		lineageTag: 414bee76-442a-5404-b7b4-43ab48609f86

	measure '_CET1 Ratio' =
			DIVIDE(SUMX(FILTER(Quarterly, NOT ISBLANK(Quarterly[fdic_cet1_ratio])), Quarterly[fdic_cet1_ratio] * Quarterly[rwa]), SUMX(FILTER(Quarterly, NOT ISBLANK(Quarterly[fdic_cet1_ratio])), Quarterly[rwa]))
		formatString: 0.00
		isHidden
		displayFolder: 00 Base (unscoped)
		lineageTag: 0d035d1f-6169-5c23-bf5b-f9bcf0855ffb

	measure '_CET1 Marked' =
