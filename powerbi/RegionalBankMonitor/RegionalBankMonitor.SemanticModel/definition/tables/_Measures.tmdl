		displayFolder: 00 Base (unscoped)
		lineageTag: 26f85bee-54a7-59b1-b7e5-90355f8ba4fc

	measure '_Fed Funds' =
			AVERAGE(Quarters[fed_funds])
		formatString: 0.00
		isHidden
		displayFolder: 00 Base (unscoped)
		lineageTag: 39357e47-4f4e-5a18-a653-dad733a45306

	measure 'Selected Quarter' =
			IF(HASONEVALUE(Quarters[quarter_end]), VALUES(Quarters[quarter_end]), CALCULATE(MAX(Quarterly[quarter_end]), REMOVEFILTERS()))
		formatString: yyyy-mm-dd
		displayFolder: 01 Core
		lineageTag: 3b0f8bc1-f481-5043-b62f-237affac6fa3

	measure 'Selected Quarter Label' =
			VAR q = [Selected Quarter]
			RETURN "Q" & QUARTER(q) & " " & YEAR(q)
		displayFolder: 01 Core
		lineageTag: d8699678-7723-5333-99df-e63b491acfe4

	measure Banks =
			VAR q = [Selected Quarter]
			RETURN CALCULATE(CALCULATE(DISTINCTCOUNT(Quarterly[cert]), KEEPFILTERS(Banks[failed] = FALSE())), REMOVEFILTERS(Quarters), Quarters[quarter_end] = q)
		formatString: 0
		displayFolder: 01 Core
		lineageTag: ed7311aa-f6f3-52a3-aab8-bfe4fc1a6e04

	measure 'Total Assets $B' =
