		lineageTag: f57d0fa2-d2d3-5fa9-b66c-f79c887ae3a9

	measure 'Flag Loans > Deposits' =
			IF(HASONEVALUE(Banks[cert]) && NOT ISBLANK([Loans / Deposits %]), IF([Loans / Deposits %] > 100, 1, 0))
		formatString: 0
		displayFolder: 06 Risk Screen
		lineageTag: 76377ed3-185d-50af-9d30-4de43abe750e

	measure 'Flag Liquidity < 50%' =
			IF(HASONEVALUE(Banks[cert]) && NOT ISBLANK([Liquidity / Uninsured %]), IF([Liquidity / Uninsured %] < 50, 1, 0))
		formatString: 0
		displayFolder: 06 Risk Screen
		lineageTag: c6027507-eaa5-5264-b263-76d32d37b698

	measure 'Flag NCO > 0.5%' =
			IF(HASONEVALUE(Banks[cert]) && NOT ISBLANK([NCO Rate %]), IF([NCO Rate %] > 0.5, 1, 0))
		formatString: 0
		displayFolder: 06 Risk Screen
		lineageTag: d772b42b-65af-53fd-8937-561b3cfede12

	measure 'Risk Flags' =
			IF(HASONEVALUE(Banks[cert]) && NOT ISBLANK([NIM %]), [Flag Uninsured > 60%] + [Flag Marked CET1 < 8%] + [Flag CRE > 300%] + [Flag Construction > 100%] + [Flag Loans > Deposits] + [Flag Liquidity < 50%] + [Flag NCO > 0.5%])
		formatString: 0
		displayFolder: 06 Risk Screen
		lineageTag: a30da95f-e4eb-5906-8d73-102eeb4599f5

	measure 'Total Risk Flags' =
			SUMX(CALCULATETABLE(VALUES(Banks[cert]), KEEPFILTERS(Banks[failed] = FALSE())), [Risk Flags]) + 0
		formatString: 0
		displayFolder: 06 Risk Screen
		lineageTag: acb9488d-4ca8-5d0e-ac48-d47a8ff4f2ed

	measure 'Banks With 2+ Flags' =
			COUNTROWS(FILTER(CALCULATETABLE(VALUES(Banks[cert]), KEEPFILTERS(Banks[failed] = FALSE())), [Risk Flags] >= 2)) + 0
		formatString: 0
		displayFolder: 06 Risk Screen
		lineageTag: a1bcb650-d736-5008-ba12-67c2788f3abb

	measure 'Banks With No Flags' =
			COUNTROWS(FILTER(CALCULATETABLE(VALUES(Banks[cert]), KEEPFILTERS(Banks[failed] = FALSE())), [Risk Flags] = 0)) + 0
		formatString: 0
		displayFolder: 06 Risk Screen
		lineageTag: 4435cb03-baa1-58d4-82ce-4a4114cace4c

	measure 'Banks Raising Flag' =
			SWITCH(SELECTEDVALUE(Flags[flag]),
			    "Uninsured deposits > 60%", COUNTROWS(FILTER(CALCULATETABLE(VALUES(Banks[cert]), KEEPFILTERS(Banks[failed] = FALSE())), [Flag Uninsured > 60%] = 1)) + 0,
			    "CET1 after securities losses < 8%", COUNTROWS(FILTER(CALCULATETABLE(VALUES(Banks[cert]), KEEPFILTERS(Banks[failed] = FALSE())), [Flag Marked CET1 < 8%] = 1)) + 0,
			    "CRE > 300% of capital", COUNTROWS(FILTER(CALCULATETABLE(VALUES(Banks[cert]), KEEPFILTERS(Banks[failed] = FALSE())), [Flag CRE > 300%] = 1)) + 0,
			    "Construction > 100% of capital", COUNTROWS(FILTER(CALCULATETABLE(VALUES(Banks[cert]), KEEPFILTERS(Banks[failed] = FALSE())), [Flag Construction > 100%] = 1)) + 0,
			    "Loans > deposits", COUNTROWS(FILTER(CALCULATETABLE(VALUES(Banks[cert]), KEEPFILTERS(Banks[failed] = FALSE())), [Flag Loans > Deposits] = 1)) + 0,
			    "Liquidity < 50% of uninsured deposits", COUNTROWS(FILTER(CALCULATETABLE(VALUES(Banks[cert]), KEEPFILTERS(Banks[failed] = FALSE())), [Flag Liquidity < 50%] = 1)) + 0,
			    "Net charge-offs > 0.5%", COUNTROWS(FILTER(CALCULATETABLE(VALUES(Banks[cert]), KEEPFILTERS(Banks[failed] = FALSE())), [Flag NCO > 0.5%] = 1)) + 0)
		formatString: 0
		displayFolder: 06 Risk Screen
		lineageTag: bc42970f-e663-5b54-83f4-c244237512cb

	measure 'Banks CRE Over 300%' =
			COUNTROWS(FILTER(CALCULATETABLE(VALUES(Banks[cert]), KEEPFILTERS(Banks[failed] = FALSE())), [CRE / Capital %] > 300)) + 0
		formatString: 0
		displayFolder: 06 Risk Screen
		lineageTag: 77d2a47a-f9a3-5a54-8df6-808935e65ef9

	measure 'Banks CRE Over 300% by Quarter' =
			COUNTROWS(FILTER(CALCULATETABLE(VALUES(Banks[cert]), KEEPFILTERS(Banks[failed] = FALSE())), [_CRE Concentration] > 300)) + 0
		formatString: 0
		displayFolder: 12 Chart Helpers
		lineageTag: e5f4ac33-9b12-5748-9087-f4b33140068e

	measure 'Uninsured at Q4 2022 %' =
			IF(HASONEVALUE(Banks[cert]), CALCULATE([_Uninsured Share], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2022, 12, 31)))
		formatString: 0.0
		displayFolder: 08 Lessons from 2023
		lineageTag: 15ee1db0-342d-580c-ad80-5f038769f274

	measure 'Marked CET1 at Q4 2022 %' =
			IF(HASONEVALUE(Banks[cert]), CALCULATE([_CET1 Marked], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2022, 12, 31)))
		formatString: 0.0
		displayFolder: 08 Lessons from 2023
		lineageTag: 835298d9-eafc-536e-8934-e678acc0369d

	measure 'Unrealized Loss / Tier 1 at Q4 2022 %' =
			IF(HASONEVALUE(Banks[cert]), CALCULATE([_Unrealized to Tier1], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2022, 12, 31)))
		formatString: 0.0
		displayFolder: 08 Lessons from 2023
		lineageTag: 75f125a8-fe90-50d8-b363-bc8c5e2c5c2a

	measure 'Deposit Growth 2019-22 %' =
			VAR d0 = CALCULATE(SUM(Quarterly[deposits]), REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2019, 12, 31))
			VAR d1 = CALCULATE(SUM(Quarterly[deposits]), REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2022, 12, 31))
			RETURN IF(HASONEVALUE(Banks[cert]) && d0 > 0, (d1 / d0 - 1) * 100)
		formatString: 0.0
		displayFolder: 08 Lessons from 2023
		lineageTag: fa82bf4b-7f2a-5324-97b3-5ceeaee0ed6a

	measure 'Early-Warning Flags' =
			VAR u = [Uninsured at Q4 2022 %]
			VAR c = [Marked CET1 at Q4 2022 %]
			VAR g = [Deposit Growth 2019-22 %]
			RETURN IF(NOT ISBLANK(u), IF(u > 60, 1, 0) + IF(c < 8, 1, 0) + IF(g > 90, 1, 0))
		formatString: 0
		displayFolder: 08 Lessons from 2023
		lineageTag: e7256cbb-ad6e-5af4-ba46-4d23a60f995a

	measure 'Failed Banks Raising All 3' =
			COUNTROWS(FILTER(CALCULATETABLE(VALUES(Banks[cert]), REMOVEFILTERS(Banks), Banks[failed] = TRUE()), [Early-Warning Flags] = 3)) + 0
		formatString: 0
		displayFolder: 08 Lessons from 2023
		lineageTag: 2e6e6221-2ab4-5565-bcbb-50a46fdef75a

	measure 'Survivors Raising All 3' =
			COUNTROWS(FILTER(CALCULATETABLE(VALUES(Banks[cert]), REMOVEFILTERS(Banks), Banks[failed] = FALSE()), [Early-Warning Flags] = 3)) + 0
		formatString: 0
		displayFolder: 08 Lessons from 2023
		lineageTag: 78c5682c-e6e5-517e-99b0-9469df960885

	measure 'Survivors Raising 2 Flags' =
			COUNTROWS(FILTER(CALCULATETABLE(VALUES(Banks[cert]), REMOVEFILTERS(Banks), Banks[failed] = FALSE()), [Early-Warning Flags] = 2)) + 0
		formatString: 0
		displayFolder: 08 Lessons from 2023
		lineageTag: bfa3d4c0-5cc4-597d-90eb-6d29051a4bf8

	measure 'Survivor Median Uninsured at Q4 2022 %' =
			CALCULATE(MEDIANX(FILTER(VALUES(Banks[cert]), NOT ISBLANK([Uninsured at Q4 2022 %])), [Uninsured at Q4 2022 %]), REMOVEFILTERS(Banks), Banks[failed] = FALSE())
		formatString: 0.0
		displayFolder: 08 Lessons from 2023
		lineageTag: 9749869f-bde1-5477-87ed-e7964a046c52

	measure 'Survivor Median Marked CET1 at Q4 2022 %' =
			CALCULATE(MEDIANX(FILTER(VALUES(Banks[cert]), NOT ISBLANK([Marked CET1 at Q4 2022 %])), [Marked CET1 at Q4 2022 %]), REMOVEFILTERS(Banks), Banks[failed] = FALSE())
		formatString: 0.0
		displayFolder: 08 Lessons from 2023
		lineageTag: c3cd07b0-74aa-58c1-9690-8610fadfc9d6

	measure 'Survivor Median Deposit Growth 2019-22 %' =
			CALCULATE(MEDIANX(FILTER(VALUES(Banks[cert]), NOT ISBLANK([Deposit Growth 2019-22 %])), [Deposit Growth 2019-22 %]), REMOVEFILTERS(Banks), Banks[failed] = FALSE())
		formatString: 0.0
		displayFolder: 08 Lessons from 2023
		lineageTag: 232d8fbb-d8b5-5780-87ca-588266a0c1f3

	measure 'Metric Value' =
			SWITCH(SELECTEDVALUE(Metrics[metric]),
			    "Net interest margin (%)", [NIM %],
			    "Cost of deposits (%)", [Cost of Deposits %],
			    "Uninsured deposits (%)", [Uninsured Deposits %],
			    "Loans / deposits (%)", [Loans / Deposits %],
			    "CRE / (Tier 1 + reserves) (%)", [CRE / Capital %],
			    "Unrealized securities loss / Tier 1 (%)", [Unrealized Loss / Tier 1 %],
			    "CET1 ratio (%)", [CET1 Ratio %],
			    "CET1 after securities losses (%)", [CET1 After Securities Losses %],
			    "Liquidity / uninsured deposits (%)", [Liquidity / Uninsured %],
			    "Return on assets (%)", [ROA %],
			    "Efficiency ratio (%)", [Efficiency %],
			    "Net charge-offs / loans (%)", [NCO Rate %])
		formatString: 0.00
		displayFolder: 10 Scorecard
		lineageTag: 262d0bc1-3a27-5bfc-9014-9fa754a080b4

	measure 'Metric Peer Median' =
			SWITCH(SELECTEDVALUE(Metrics[metric]),
			    "Net interest margin (%)", [Peer Median NIM %],
			    "Cost of deposits (%)", [Peer Median Cost of Deposits %],
			    "Uninsured deposits (%)", [Peer Median Uninsured Deposits %],
			    "Loans / deposits (%)", [Peer Median Loans / Deposits %],
			    "CRE / (Tier 1 + reserves) (%)", [Peer Median CRE / Capital %],
			    "Unrealized securities loss / Tier 1 (%)", [Peer Median Unrealized Loss / Tier 1 %],
			    "CET1 ratio (%)", [Peer Median CET1 Ratio %],
			    "CET1 after securities losses (%)", [Peer Median CET1 After Securities Losses %],
			    "Liquidity / uninsured deposits (%)", [Peer Median Liquidity / Uninsured %],
			    "Return on assets (%)", [Peer Median ROA %],
			    "Efficiency ratio (%)", [Peer Median Efficiency %],
			    "Net charge-offs / loans (%)", [Peer Median NCO Rate %])
		formatString: 0.00
		displayFolder: 10 Scorecard
		lineageTag: 9d372172-416d-5f25-8fff-08265181f1c1

	measure 'Metric Rank' =
			VAR v = [Metric Value]
			VAR lower = SELECTEDVALUE(Metrics[lower_is_better])
			RETURN IF(NOT ISBLANK(v), CALCULATE(IF(lower, COUNTROWS(FILTER(VALUES(Banks[cert]), [Metric Value] < v)),
			    COUNTROWS(FILTER(VALUES(Banks[cert]), [Metric Value] > v))), REMOVEFILTERS(Banks), Banks[failed] = FALSE()) + 1)
		formatString: 0
		displayFolder: 10 Scorecard
		lineageTag: 8a1ec7b2-cbf7-5eec-abab-781b31d68249

	measure 'Rows Included' =
			CALCULATE(COUNTROWS(Quarterly), KEEPFILTERS(Quarterly[governance_label] = "Include"))
		formatString: 0
		displayFolder: 11 Governance & QA
		lineageTag: e1908207-654a-59f8-a51c-3c88af83e308

	measure 'Rows Needing Review' =
			CALCULATE(COUNTROWS(Quarterly), KEEPFILTERS(Quarterly[needs_review] = TRUE())) + 0
		formatString: 0
		displayFolder: 11 Governance & QA
		lineageTag: 765f4aba-1ce8-508a-8f1b-820aca3916e8

	measure 'Fact Rows' =
			COUNTROWS(Quarterly)
		formatString: #,0
		displayFolder: 11 Governance & QA
		lineageTag: 0c1dc1fa-24ce-5003-ae2c-9c51b526d8e8

	measure 'Python Value' =
			SUM(Reconciliation[python_value])
		formatString: 0.000
		displayFolder: 11 Governance & QA
		lineageTag: b2cd2bbc-b9ec-5d13-b29e-b0046bcc12e0

	measure 'DAX Value' =
			SWITCH(SELECTEDVALUE(Reconciliation[check_id]),
			    "banks", CALCULATE([Banks], Quarters[quarter_end] = DATE(2026, 6, 30)),
			    "assets_t", CALCULATE([Total Assets $B], Quarters[quarter_end] = DATE(2026, 6, 30)) / 1000,
			    "nim_median", CALCULATE([Median NIM %], Quarters[quarter_end] = DATE(2026, 6, 30)),
			    "depcost_median", CALCULATE([Median Cost of Deposits %], Quarters[quarter_end] = DATE(2026, 6, 30)),
			    "uninsured_median", CALCULATE([Median Uninsured Deposits %], Quarters[quarter_end] = DATE(2026, 6, 30)),
			    "cet1_median", CALCULATE([Median CET1 Ratio %], Quarters[quarter_end] = DATE(2026, 6, 30)),
			    "beta_up", [Median Deposit Beta (Hikes)],
			    "beta_down", [Median Deposit Beta (Cuts)],
			    "nim100_median", [Median NIM Change per +100bp],
			    "liab_sensitive", [Banks Losing Margin as Rates Rise],
			    "flags_total", CALCULATE([Total Risk Flags], Quarters[quarter_end] = DATE(2026, 6, 30)),
			    "flags_two_plus", CALCULATE([Banks With 2+ Flags], Quarters[quarter_end] = DATE(2026, 6, 30)),
			    "flags_zero", CALCULATE([Banks With No Flags], Quarters[quarter_end] = DATE(2026, 6, 30)),
			    "cre_over_300", CALCULATE([Banks CRE Over 300%], Quarters[quarter_end] = DATE(2026, 6, 30)),
			    "svb_uninsured", CALCULATE([_Uninsured Share], Banks[cert] = 24735, Quarters[quarter_end] = DATE(2022, 12, 31)),
			    "frc_marked", CALCULATE([_CET1 Marked], Banks[cert] = 59017, Quarters[quarter_end] = DATE(2022, 12, 31)),
			    "ew_failed", [Failed Banks Raising All 3],
			    "ew_survivors", [Survivors Raising All 3],
			    "flagstar_nim100", CALCULATE([NIM Change per +100bp], Banks[cert] = 32541),
			    "mt_depcost_peak", CALCULATE([_Deposit Cost], Banks[cert] = 588, Quarters[quarter_end] = DATE(2024, 6, 30)))
		formatString: 0.000
		displayFolder: 11 Governance & QA
		lineageTag: 49836da4-22af-5e6f-b685-3df2876b9854

	measure Difference =
			IF(HASONEVALUE(Reconciliation[check_id]), [DAX Value] - [Python Value])
		formatString: 0.000
		displayFolder: 11 Governance & QA
		lineageTag: 189325a1-d97b-5ebf-99f3-65ecfdc601b2

	measure 'Check Status' =
			IF(HASONEVALUE(Reconciliation[check_id]), IF(ABS([Difference]) <= 0.01, "PASS", "REVIEW"))
		displayFolder: 11 Governance & QA
		lineageTag: 8c295299-940f-52fb-8bde-c2c0d12f8484

	measure 'Checks Passed' =
			SUMX(VALUES(Reconciliation[check_id]), IF(ABS([DAX Value] - [Python Value]) <= 0.01, 1, 0))
		formatString: 0
		displayFolder: 11 Governance & QA
		lineageTag: a99e3bbb-d474-5d6e-a751-787adcba8748

	measure 'Reconciliation Status' =
			IF([Checks Passed] = COUNTROWS(Reconciliation), "PASS (" & [Checks Passed] & " of " & COUNTROWS(Reconciliation) & ")", "REVIEW")
		displayFolder: 11 Governance & QA
		lineageTag: ee83e53e-4297-51a5-9e3d-dd5cff8164a9

	measure 'Finding Value' =
			SUM(Findings[value])
		formatString: 0.00
		displayFolder: 11 Governance & QA
		lineageTag: 6b8e317d-43cf-5ae3-a1f1-7bb1f5eef2d9

	measure 'Finding p-value' =
			SUM(Findings[p_value])
		formatString: 0.000
		displayFolder: 11 Governance & QA
		lineageTag: f3d4272e-1bb6-57c0-8ab0-75cfdc07d6d5

	column Placeholder
		dataType: string
		isHidden
		lineageTag: 07e57783-fa50-5f85-9cb2-4582b5a2a42e
		summarizeBy: none
		sourceColumn: Placeholder

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows({}, type table [Placeholder = text])
				in
				    Source

	annotation PBI_ResultType = Table
