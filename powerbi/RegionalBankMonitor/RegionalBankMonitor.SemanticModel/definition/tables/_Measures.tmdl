	measure 'Deposit Beta (Hikes)' =
			VAR c0 = CALCULATE([_Deposit Cost], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2021, 12, 31))
			VAR c1 = CALCULATE([_Deposit Cost], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2024, 6, 30))
			VAR f0 = CALCULATE([_Fed Funds], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2021, 12, 31))
			VAR f1 = CALCULATE([_Fed Funds], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2024, 6, 30))
			RETURN IF(HASONEVALUE(Banks[cert]) && NOT ISBLANK(c0) && NOT ISBLANK(c1), DIVIDE(c1 - c0, f1 - f0))
		formatString: 0.00
		displayFolder: 05 Rate Sensitivity
		lineageTag: c7a7b66b-b0ca-55dc-be29-38f1e1ea7c45

	measure 'Deposit Beta (Cuts)' =
			VAR c0 = CALCULATE([_Deposit Cost], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2024, 6, 30))
			VAR c1 = CALCULATE([_Deposit Cost], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2026, 6, 30))
			VAR f0 = CALCULATE([_Fed Funds], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2024, 6, 30))
			VAR f1 = CALCULATE([_Fed Funds], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2026, 6, 30))
			RETURN IF(HASONEVALUE(Banks[cert]) && NOT ISBLANK(c0) && NOT ISBLANK(c1), DIVIDE(c1 - c0, f1 - f0))
		formatString: 0.00
		displayFolder: 05 Rate Sensitivity
		lineageTag: e4d2b901-df90-54b7-9e62-55be18a78fb9

	measure 'Asset Yield Beta' =
			VAR c0 = CALCULATE([_Asset Yield], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2021, 12, 31))
			VAR c1 = CALCULATE([_Asset Yield], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2024, 6, 30))
			VAR f0 = CALCULATE([_Fed Funds], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2021, 12, 31))
			VAR f1 = CALCULATE([_Fed Funds], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2024, 6, 30))
			RETURN IF(HASONEVALUE(Banks[cert]) && NOT ISBLANK(c0) && NOT ISBLANK(c1), DIVIDE(c1 - c0, f1 - f0))
		formatString: 0.00
		displayFolder: 05 Rate Sensitivity
		lineageTag: 707e15f2-fea8-5533-89cd-f994e991c94b

	measure 'Funding Cost Beta' =
			VAR c0 = CALCULATE([_Cost of Funds], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2021, 12, 31))
			VAR c1 = CALCULATE([_Cost of Funds], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2024, 6, 30))
			VAR f0 = CALCULATE([_Fed Funds], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2021, 12, 31))
			VAR f1 = CALCULATE([_Fed Funds], REMOVEFILTERS(Quarters), Quarters[quarter_end] = DATE(2024, 6, 30))
			RETURN IF(HASONEVALUE(Banks[cert]) && NOT ISBLANK(c0) && NOT ISBLANK(c1), DIVIDE(c1 - c0, f1 - f0))
