		lineageTag: 0cabde59-0a18-5c4a-8152-4afb88a2704d

	measure '_Deposits $B' =
			DIVIDE(SUM(Quarterly[deposits]), 1000)
		formatString: 0.00
		isHidden
		displayFolder: 00 Base (unscoped)
		lineageTag: 2673d909-c9c0-5a13-a92e-f8c02c005821

	measure '_Assets $B' =
