		displayFolder: 00 Base (unscoped)
		lineageTag: 8e3f4e7a-67ed-582e-9abd-63aec7a2dfef

	measure '_Unrealized to Tier1' =
			DIVIDE(SUM(Quarterly[unrealized_securities]), SUM(Quarterly[tier1_capital])) * 100
		formatString: 0.00
		isHidden
		displayFolder: 00 Base (unscoped)
		lineageTag: dd8195fb-a16c-56d1-8aea-3d1fb9b11c1a

	measure '_Liquidity Coverage' =
			DIVIDE(SUM(Quarterly[liquid_assets]), SUM(Quarterly[uninsured_deposits])) * 100
