table _Measures
	lineageTag: d12066e6-4d4b-589c-a982-ead8115e34d4

	measure _NIM =
			DIVIDE(SUMX(FILTER(Quarterly, NOT ISBLANK(Quarterly[fdic_nim])), Quarterly[fdic_nim] * Quarterly[earning_assets]), SUMX(FILTER(Quarterly, NOT ISBLANK(Quarterly[fdic_nim])), Quarterly[earning_assets]))
		formatString: 0.00
		isHidden
		displayFolder: 00 Base (unscoped)
		lineageTag: 6c859138-6da1-5970-b6d1-d69b23d73097

	measure '_Asset Yield' =
			DIVIDE(SUMX(FILTER(Quarterly, NOT ISBLANK(Quarterly[fdic_asset_yield])), Quarterly[fdic_asset_yield] * Quarterly[earning_assets]), SUMX(FILTER(Quarterly, NOT ISBLANK(Quarterly[fdic_asset_yield])), Quarterly[earning_assets]))
		formatString: 0.00
		isHidden
		displayFolder: 00 Base (unscoped)
		lineageTag: f49012cd-7e10-55d4-bcfb-788ed914c61b

	measure '_Cost of Funds' =
			DIVIDE(SUMX(FILTER(Quarterly, NOT ISBLANK(Quarterly[fdic_cost_of_funds])), Quarterly[fdic_cost_of_funds] * Quarterly[earning_assets]), SUMX(FILTER(Quarterly, NOT ISBLANK(Quarterly[fdic_cost_of_funds])), Quarterly[earning_assets]))
		formatString: 0.00
		isHidden
		displayFolder: 00 Base (unscoped)
		lineageTag: 7191c877-3d54-54dd-a050-9e08ee2cda9e

	measure '_Deposit Cost' =
			DIVIDE(SUM(Quarterly[deposit_interest_expense]) * 4, SUM(Quarterly[avg_domestic_deposits])) * 100
		formatString: 0.00
		isHidden
		displayFolder: 00 Base (unscoped)
		lineageTag: 1f14e61a-65b0-5276-bffb-a5f96d3bea63

	measure '_Uninsured Share' =
			DIVIDE(SUM(Quarterly[uninsured_deposits]), SUM(Quarterly[domestic_deposits])) * 100
		formatString: 0.00
		isHidden
		displayFolder: 00 Base (unscoped)
		lineageTag: 90e98fc2-fd00-5b85-a8b4-2ec634b1a5d7

	measure '_Loan to Deposit' =
			DIVIDE(SUM(Quarterly[loans]), SUM(Quarterly[deposits])) * 100
		formatString: 0.00
		isHidden
		displayFolder: 00 Base (unscoped)
		lineageTag: 27757f6d-151c-53dc-961e-5ef9f07b496e

	measure '_Brokered Share' =
			DIVIDE(SUM(Quarterly[brokered_deposits]), SUM(Quarterly[deposits])) * 100
		formatString: 0.00
		isHidden
		displayFolder: 00 Base (unscoped)
		lineageTag: fb26cf10-e895-5a20-8101-688cfc6dbbaa

	measure '_CRE Concentration' =
			DIVIDE(SUM(Quarterly[cre_loans]), SUM(Quarterly[capital_base])) * 100
		formatString: 0.00
		isHidden
		displayFolder: 00 Base (unscoped)
		lineageTag: d2345dc7-1ea9-50ab-bf75-5bf75bcafa6b

	measure '_Construction Concentration' =
			DIVIDE(SUM(Quarterly[construction_loans]), SUM(Quarterly[capital_base])) * 100
