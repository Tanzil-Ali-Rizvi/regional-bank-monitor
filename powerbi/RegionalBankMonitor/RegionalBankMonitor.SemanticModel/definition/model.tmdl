model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "Quarterly_Source", "Quarterly_Staging", "Banks_Source", "Banks_Staging", "Rates_Source", "Quarterly", "Banks", "Quarters", "Metrics", "Flags", "Findings", "Reconciliation", "Model Guide", "_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

queryGroup '1 Parameters'

	annotation PBI_QueryGroupOrder = 0

queryGroup '2 Source (raw)'

	annotation PBI_QueryGroupOrder = 1

queryGroup '3 Staging'

	annotation PBI_QueryGroupOrder = 2

ref table Quarterly
ref table Banks
ref table Quarters
ref table Metrics
ref table Flags
ref table Findings
ref table Reconciliation
ref table 'Model Guide'
ref table _Measures
